# Copy this file to `.env` and fill in real values. Never commit `.env` itself.

# Required. The bot wallet's private key (0x-prefixed hex), testnet-only. This wallet pays gas for
# pokeSettlement calls and receives the pokeBounty payout each time it resolves a stalled dispute.
# Fund it with a small amount of Chiado test xDAI (from a Gnosis Chiado faucet) before starting the bot.
PRIVATE_KEY=

# Optional. Defaults to the public Chiado RPC used by walendria-app if unset.
# RPC_URL=https://rpc.chiadochain.net

# Optional. How often to check for pokeable disputes, in milliseconds. Default: 5 minutes.
# The cumulative window being watched is 1 hour, so polling much faster than this has no benefit.
# POLL_INTERVAL_MS=300000

# Optional. How often the indexer catches up on new on-chain events, in milliseconds. Default: 30s.
# INDEX_INTERVAL_MS=30000

# Optional. Max block range per eth_getLogs call while catching up. Default: 5000.
# INDEX_CHUNK_SIZE=5000

# Optional. Port the read-only indexer HTTP API listens on. Default: 4000.
# HTTP_PORT=4000

# Optional. Where the indexed event data (a plain JSON file) is written. Default: <this folder>/data.json.
# DB_PATH=./data.json

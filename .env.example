# Copy this file to .env and fill in values as needed. The real .env is already gitignored - never commit it.
# NEVER put a real private key in here or anywhere in this repo. script/Deploy.s.sol never reads a private key
# itself - it broadcasts via whatever --account (keystore) / --private-key / --ledger flag you pass to
# `forge script` directly on the command line, so key material never has to live in a file.

# Required. Must exactly match the address that will actually sign the broadcast (your --account/--sender).
# Used only to pre-compute future contract addresses before anything is deployed - a mismatch here is caught
# by the script's own require() checks rather than silently producing bad wiring.
DEPLOYER_ADDRESS=

# Optional - all default to DEPLOYER_ADDRESS if unset.
DEVELOPER_ADDRESS=
WITHDRAWAL_RECIPIENT=

# Optional - wei. Defaults shown are the testnet placeholders script/Deploy.s.sol falls back to.
POKE_BOUNTY=1000000000000000
INITIAL_BOUNTY_FUNDING=10000000000000000
